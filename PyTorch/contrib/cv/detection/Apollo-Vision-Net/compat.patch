diff --git a/projects/mmdet3d_plugin/models/npu_focal_loss.py b/projects/mmdet3d_plugin/models/npu_focal_loss.py
new file mode 100644
--- /dev/null
+++ b/projects/mmdet3d_plugin/models/npu_focal_loss.py
@@ -0,0 +1,22 @@
+"""Use the upstream PyTorch focal loss on NPU with identical reduction rules."""
+import torch.nn.functional as F
+from mmdet.models.builder import LOSSES
+from mmdet.models.losses.focal_loss import FocalLoss, py_sigmoid_focal_loss
+
+
+@LOSSES.register_module()
+class NpuFocalLoss(FocalLoss):
+    def forward(self, pred, target, weight=None, avg_factor=None,
+                reduction_override=None):
+        if pred.device.type != 'npu' or self.activated:
+            return super().forward(pred, target, weight, avg_factor,
+                                   reduction_override)
+        if reduction_override not in (None, 'none', 'mean', 'sum'):
+            raise ValueError('Invalid focal loss reduction')
+        reduction = reduction_override or self.reduction
+        # Preserve the upstream background class (index C) as an all-zero row.
+        targets = F.one_hot(target, num_classes=pred.size(1) + 1)
+        targets = targets[:, :pred.size(1)]
+        return self.loss_weight * py_sigmoid_focal_loss(
+            pred, targets, weight, gamma=self.gamma, alpha=self.alpha,
+            reduction=reduction, avg_factor=avg_factor)
